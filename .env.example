# Copy to .env and fill in. .env is never committed.

# Password for editing. Pick a real one - the site is reachable from the internet.
ADMIN_PASSWORD=change-me

# Postgres password. Only reachable inside the compose network.
POSTGRES_PASSWORD=afro

# Port the site is served on locally.
WEB_PORT=8764

# Cloudflare Tunnel token: Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker.
# In the tunnel's public hostname, point afro.offlinebot.xyz at http://web:80
TUNNEL_TOKEN=
